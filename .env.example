# The Supabase project. The URL and publishable key are public: the build
# reads the current curriculum release with them (npm run curriculum:pull).
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only, for the academic office at /admin. Set these in Vercel's
# environment settings; never in anything that ships to the browser.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
ADMIN_PASSWORD=choose-a-long-password
# optional: publishing asks Vercel to rebuild the site with the new release
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/YOUR_HOOK
